{
  "name": "secure-file-intake",
  "version": "0.1.0",
  "description": "Secure partner file intake on AWS: S3 drop zone, TypeScript Lambda validation, quarantine, and alerting, defined in AWS CDK and deployed with GitHub Actions.",
  "license": "MIT",
  "author": "Brad Brooks",
  "bin": {
    "secure-file-intake": "bin/app.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy --require-approval never",
    "destroy": "cdk destroy --force",
    "build:lambda": "esbuild lambda/handler.ts --bundle --platform=node --target=node22 --format=cjs --minify --sourcemap --external:@aws-sdk/* --outfile=terraform/build/index.js"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "aws-cdk": "^2.170.0",
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2"
  }
}
